# ============================================================================
# COMPREHENSIVE GITIGNORE FOR SCRIBES QUILL
# Purpose: Prevent sensitive, LLM-generated, and unnecessary files from git
# ============================================================================

# ============================================================================
# ENVIRONMENT & SECRETS (CRITICAL - NEVER COMMIT)
# ============================================================================
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
.env.*.example.local

# ============================================================================
# DEPENDENCIES (Auto-installed, huge, not needed in repo)
# ============================================================================
node_modules/
/.pnp
.pnp.js

# ============================================================================
# BUILD ARTIFACTS (Generated, not source code)
# ============================================================================
dist/
dist-ssr/
build/
.next/
.nuxt/
.output/
.output-metadata/
.cache/
*.tsbuildinfo
.tsc-cache/

# ============================================================================
# VITE SPECIFIC
# ============================================================================
.vite/
vite.cache/
vite-env.d.ts.bak

# ============================================================================
# TESTING (Generated, not source)
# ============================================================================
coverage/
.coverage/
*.lcov
.nyc_output/
.jest-cache/
.vitest/

# ============================================================================
# IDE & EDITOR (Personal preferences, not needed)
# ============================================================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.sublime-project
*.sublime-workspace
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-settings
.history/
.cache/
*.orig

# ============================================================================
# LOGS (Debug/runtime, not source)
# ============================================================================
logs/
*.log
*.log.*
npm-debug.log*
npm-err.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
pnpm-err.log*
lerna-debug.log*
.pnpm-debug.log

# ============================================================================
# TEMPORARY FILES (Should never commit)
# ============================================================================
.tmp/
*.tmp
tmp/
temp/
*.temp
*.swp
*.bak
*.orig
*~
.DS_Store

# ============================================================================
# OS & SYSTEM FILES (Platform-specific, not needed)
# ============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ============================================================================
# DOCUMENTATION (User requested: ignore all .md files)
# ============================================================================
*.md
*.markdown
!README.md
docs/
*.pdf
*.docx

# ============================================================================
# COPILOT & LLM ARTIFACTS (NEVER commit)
# ============================================================================
# GitHub Copilot
.github/copilot-config.json
copilot.log

# Claude/Anthropic
claude.log
claude-session.json
.claude/
.anthropic/

# LLM Assistant Related
.ai/
.llm/
.gpt/
.openai/
.gemini/
ai-logs/
llm-cache/
*-llm.md
*-ai-generated.md
*.ai-backup
copilot-instructions.md
llm-context.md
ai-prompts.txt
assistant-history.json
.copilot/
.copilot-cli/

# ============================================================================
# BUILD & DEPLOYMENT
# ============================================================================
.railway-cli
.railwayignore
dist/
build-cache/
.vercel/
.next/
.nuxt/
.output/

# ============================================================================
# SUPABASE (Keep migrations & edge-functions, ignore temp files)
# ============================================================================
.supabase/
.migrate-cache
supabase/.branches
supabase/.temp/
supabase/*.js
supabase/supa/
supabase/smoke_tests/

# ============================================================================
# TESTING & CI/CD (Local test artifacts)
# ============================================================================
.circleci/
.github/workflows/
.gitlab-ci.yml
.travis.yml

# ============================================================================
# DEVELOPMENT UTILITIES (Not needed in production)
# ============================================================================
.editorconfig
.prettierignore
.prettierrc.json
.eslintignore
.eslintcache
.stylelintignore

# ============================================================================
# DOCKER & CONTAINER (If using, keep images/volumes local)
# ============================================================================
.docker/
docker-compose.override.yml
.dockerignore
Dockerfile.dev

# ============================================================================
# PACKAGE MANAGER LOCK FILES (Controversial, but keeping for consistency)
# ============================================================================
# Uncomment if you want to exclude lock files (not recommended)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# ============================================================================
# PRIVATE FILES (Personal, not meant for public)
# ============================================================================
*.secret
*.private
*.key
*.pem
private/
secrets/
.private/

# ============================================================================
# DATABASE (Local instances, migrations only)
# ============================================================================
*.db
*.sqlite
*.sqlite3
database/
data/

# ============================================================================
# MISC (Everything else that shouldn't be committed)
# ============================================================================
.env-example.bak
.git-credentials
.ssh/
.gnupg/
.aws/
*.pid
*.seed
.pre-commit-config.yaml
.git-hooks-config.json

# Backup files
*.backup
*.bak
*.old
*.tmp~

