# Dependencies (auto-installed)
node_modules/
/.pnp
.pnp.js

# Build artifacts (generated by Vite)
dist/
dist-ssr/
*.tsbuildinfo

# Vite cache
.vite/
vite.cache/

# Environment secrets (CRITICAL - never commit)
.env
.env.local
.env.*.local

# Logs
logs/
*.log
npm-debug.log*
npm-err.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing
coverage/
.vitest/

# OS
.DS_Store
Thumbs.db

# IDE (if created)
.vscode/
.idea/

# Temporary
.tmp/
*.tmp
*.swp
*.bak
*.orig

# Documentation (all moved to md/ folder but not committed to git)
/md/

# AI coding agent workspace
.opencode/


# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
!.env.example
